# --- Telegram ---------------------------------------------------------
# Токен бота, выданный @BotFather.
BOT_TOKEN=

# Публичный HTTPS-адрес Mini App (для кнопки запуска в боте).
# При локальной разработке используйте туннель, например:
#   cloudflared tunnel --url http://localhost:8000
#   ngrok http 8000
# и впишите выданный https-адрес сюда.
WEBAPP_URL=https://example.com

# --- Искусственный интеллект -----------------------------------------
# Ключ доступа к OpenAI-совместимому API. Если оставить пустым,
# приложение автоматически перейдёт на резервный разбор без нейросети.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- База данных ------------------------------------------------------
DB_PATH=hotels.db

# --- Необязательно ---------------------------------------------------------
# Прокси для связи бота с Telegram, если нужен (http://127.0.0.1:порт).
# Не нужно, если VPN работает в режиме TUN (на весь компьютер).
TELEGRAM_PROXY=
# Показывать в боте кнопку Mini App (нужен постоянный https-адрес WEBAPP_URL).
ENABLE_WEBAPP=0

# Бесплатный ИИ (Groq): ключ на https://console.groq.com/keys
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
